---
/**
 * Verstopt extraatje: dubbelklikken op het OV-merkteken (zie
 * data-ov-logo-trigger in top-bar.tsx, app-header.tsx en onderdeel.astro)
 * opent een kiezer met twee spelletjes. Bewust geen React-eiland — overlay,
 * een paar timers en een beetje DOM-gepuzzel hebben geen framework nodig, dus
 * dit is gewoon een Astro-component met een vanilla scriptje. Overal waar het
 * OV-logo verschijnt staat ook precies één van deze componenten, zodat er
 * nooit twee overlays op elkaar kunnen staan.
 */
const WERKPLAATS_SPEELDUUR = 30;
const AANTAL_SLOTS = 9;
const MEMORY_SPEELDUUR = 45;
const AANTAL_PAREN = 6;
const AANTAL_KAARTEN = AANTAL_PAREN * 2;
---

<div
  id="ov-spel-overlay"
  class="no-print fixed inset-0 z-[100] hidden items-center justify-center p-4"
  style="background: rgba(21,33,43,.55)"
  role="dialog"
  aria-modal="true"
  aria-label="Verstopt extraatje"
>
  <div class="w-full max-w-[400px] rounded-card bg-creme p-5 shadow-[var(--shadow-hover)]">
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-2.5">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-tint text-accent-ink">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z"/></svg>
        </span>
        <div>
          <p class="font-body text-[10.5px] font-extrabold uppercase tracking-[0.14em] text-text-muted">
            Verstopt extraatje
          </p>
          <h2 id="ov-spel-titel" class="display text-[19px] leading-tight text-ink">Kies een spel</h2>
        </div>
      </div>
      <button
        type="button"
        id="ov-spel-sluiten"
        aria-label="Spel sluiten"
        class="motion flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-text-muted hover:bg-neutral-fill hover:text-ink"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>

    {/* Scherm 0: welk spel */}
    <div data-scherm="kiezen" class="mt-4">
      <p class="text-[13.5px] text-text-medium">Welk spelletje wil je spelen?</p>
      <div class="mt-3 flex flex-col gap-2">
        <button
          type="button"
          class="ov-spel-keuze motion flex items-center gap-3 rounded-card border border-border-light p-3 text-left hover:border-accent hover:bg-neutral-fill"
          data-spel="werkplaatsRush"
        >
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-card bg-amber-tint text-amber-text">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z"/></svg>
          </span>
          <span class="min-w-0">
            <span class="block text-[14px] font-extrabold text-ink">Werkplaats Rush</span>
            <span class="block text-[11.5px] text-text-muted">
              Tik weg wat onderhoud nodig heeft, voor de tijd om is
            </span>
          </span>
        </button>
        <button
          type="button"
          class="ov-spel-keuze motion flex items-center gap-3 rounded-card border border-border-light p-3 text-left hover:border-accent hover:bg-neutral-fill"
          data-spel="onderhoudMemory"
        >
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-card bg-accent-tint text-accent-ink">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="8" height="10" rx="1.5"/><rect x="13" y="10" width="8" height="10" rx="1.5"/><path d="M7 4V2.5M17 10V8.5"/></svg>
          </span>
          <span class="min-w-0">
            <span class="block text-[14px] font-extrabold text-ink">Onderhoud Memory</span>
            <span class="block text-[11.5px] text-text-muted">
              Vind alle paren voor de tijd om is
            </span>
          </span>
        </button>
      </div>
    </div>

    {/* Scherm 1 (gedeeld): uitleg + start, inhoud wisselt met het gekozen spel */}
    <div data-scherm="intro" class="mt-4 hidden">
      <button
        type="button"
        id="ov-spel-terug"
        class="motion mb-2 flex items-center gap-1 text-[12px] font-semibold text-link hover:underline"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Ander spel kiezen
      </button>
      <p id="ov-spel-uitleg" class="text-[13.5px] leading-relaxed text-text-medium"></p>
      <div id="ov-spel-regels" class="mt-3 flex flex-col gap-1.5 text-[12px] text-text-muted"></div>
      <p id="ov-spel-topscore-regel" class="mt-3 hidden text-[12.5px] text-text-muted">
        Beste score op dit toestel: <strong id="ov-spel-topscore" class="text-ink">0</strong>
      </p>
      <button
        type="button"
        id="ov-spel-start"
        class="motion mt-4 flex min-h-[46px] w-full items-center justify-center gap-2 rounded-full bg-accent px-5 text-[13px] font-extrabold uppercase tracking-[0.08em] text-accent-on hover:bg-accent-pressed"
      >
        Start
      </button>
    </div>

    {/* Scherm 2a: Werkplaats Rush */}
    <div data-scherm="spel-werkplaatsRush" class="mt-4 hidden">
      <div class="flex items-center justify-between text-[12.5px]">
        <span class="font-bold text-ink">Score: <span id="ov-spel-score">0</span></span>
        <span class="text-text-muted"><span id="ov-spel-tijd">{WERKPLAATS_SPEELDUUR}</span>s</span>
      </div>
      <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-zand">
        <div
          id="ov-spel-balk"
          class="h-full w-full rounded-full bg-accent transition-[width] duration-1000 ease-linear"
        >
        </div>
      </div>
      <div id="ov-spel-rooster" class="mt-3 grid grid-cols-3 gap-2">
        {
          Array.from({ length: AANTAL_SLOTS }).map((_, i) => (
            <button
              type="button"
              class="ov-slot relative flex aspect-square items-center justify-center rounded-card border border-dashed border-border-light bg-zand"
              data-slot={i}
              aria-label="Rekvak"
            />
          ))
        }
      </div>
    </div>

    {/* Scherm 2b: Onderhoud Memory */}
    <div data-scherm="spel-onderhoudMemory" class="mt-4 hidden">
      <div class="flex items-center justify-between text-[12.5px]">
        <span class="font-bold text-ink">Score: <span id="ov-memory-score">0</span></span>
        <span class="text-text-muted"><span id="ov-memory-tijd">{MEMORY_SPEELDUUR}</span>s</span>
      </div>
      <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-zand">
        <div
          id="ov-memory-balk"
          class="h-full w-full rounded-full bg-accent transition-[width] duration-1000 ease-linear"
        >
        </div>
      </div>
      <div id="ov-memory-rooster" class="mt-3 grid grid-cols-3 gap-2">
        {
          Array.from({ length: AANTAL_KAARTEN }).map((_, i) => (
            <button
              type="button"
              class="ov-kaart flex aspect-square items-center justify-center rounded-card border border-border-light bg-navy text-creme"
              data-kaart={i}
              aria-label="Kaart omdraaien"
            />
          ))
        }
      </div>
    </div>

    {/* Scherm 3 (gedeeld): score */}
    <div data-scherm="einde" class="mt-4 hidden text-center">
      <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-accent-tint text-accent-ink">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14.66V17a1 1 0 0 1-1 1 2 2 0 0 0-2 2v2"/><path d="M14 14.66V17a1 1 0 0 0 1 1 2 2 0 0 1 2 2v2"/><path d="M17.916 10H19.5A2.5 2.5 0 0 0 22 7.5V5a1 1 0 0 0-1-1h-3"/><path d="M4 22h16"/><path d="M6 9a6 6 0 0 0 12 0V3a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1z"/><path d="M6.084 10H4.5A2.5 2.5 0 0 1 2 7.5V5a1 1 0 0 1 1-1h3"/></svg>
      </span>
      <p class="display mt-2 text-[30px] leading-none text-ink"><span id="ov-spel-eindscore">0</span></p>
      <p class="mt-0.5 text-[12px] uppercase tracking-[0.1em] text-text-muted">punten</p>
      <p id="ov-spel-record" class="mt-2 hidden text-[12.5px] font-bold text-accent-ink">
        Nieuw record op dit toestel
      </p>
      <p id="ov-spel-eindtopscore" class="mt-1 text-[12px] text-text-muted">
        Beste score: <strong class="text-ink">0</strong>
      </p>
      <div class="mt-4 flex justify-center gap-2.5">
        <button
          type="button"
          id="ov-spel-klaar"
          class="motion flex min-h-[44px] items-center justify-center rounded-full border-[1.5px] border-ink px-5 text-[13px] font-extrabold uppercase tracking-[0.08em] text-ink hover:bg-neutral-fill"
        >
          Sluiten
        </button>
        <button
          type="button"
          id="ov-spel-opnieuw"
          class="motion flex min-h-[44px] items-center justify-center rounded-full bg-accent px-5 text-[13px] font-extrabold uppercase tracking-[0.08em] text-accent-on hover:bg-accent-pressed"
        >
          Nog een keer
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  /* Alleen hier nodig — geen entree-animaties in de rest van de app, maar
     een spelletje mag best een beetje leven. */
  @media (prefers-reduced-motion: no-preference) {
    .ov-item {
      animation: ov-verschijnen 140ms ease-out;
    }
    .ov-slot.ov-item-actief {
      border-style: solid;
      border-color: transparent;
      background: transparent;
    }
    @keyframes ov-verschijnen {
      from {
        transform: scale(0.6);
        opacity: 0;
      }
      to {
        transform: scale(1);
        opacity: 1;
      }
    }
    .ov-slot.ov-flits-goed {
      animation: ov-flits-goed 220ms ease-out;
    }
    .ov-slot.ov-flits-fout {
      animation: ov-flits-fout 220ms ease-out;
    }
    @keyframes ov-flits-goed {
      0% {
        transform: scale(1);
      }
      40% {
        transform: scale(0.85);
      }
      100% {
        transform: scale(1);
      }
    }
    @keyframes ov-flits-fout {
      0%,
      100% {
        transform: translateX(0);
      }
      25% {
        transform: translateX(-3px);
      }
      75% {
        transform: translateX(3px);
      }
    }
    .ov-kaart.ov-kaart-fout {
      animation: ov-flits-fout 220ms ease-out;
    }
  }
  /* Kaart-omdraai-effect kan altijd aan: het is een korte, duidelijke overgang,
     geen rondslingerende beweging, dus ook prima bij reduced-motion. */
  .ov-kaart {
    transition:
      background-color 160ms ease-out,
      border-color 160ms ease-out,
      color 160ms ease-out;
  }
  .ov-kaart.ov-kaart-open {
    background-color: var(--creme);
    border-color: var(--border-light);
    color: var(--ink);
  }
  .ov-kaart.ov-kaart-gevonden {
    background-color: var(--green-tint);
    border-color: transparent;
    color: var(--green-text);
    cursor: default;
  }
</style>

<script define:vars={{ WERKPLAATS_SPEELDUUR, MEMORY_SPEELDUUR, AANTAL_PAREN }}>
  /**
   * Vanilla JS, bewust: dit is een verstopt extraatje, geen appfunctionaliteit,
   * en verdient dus geen React-eiland en geen bundle-gewicht van een
   * animatiebibliotheek. Eén instantie per pagina (zie EasterEggSpel.astro se
   * docblock) — geen dubbele listeners.
   */
  (function () {
    const overlay = document.getElementById("ov-spel-overlay");
    if (!overlay) return;

    const schermen = overlay.querySelectorAll("[data-scherm]");
    const titelEl = document.getElementById("ov-spel-titel");
    const uitlegEl = document.getElementById("ov-spel-uitleg");
    const regelsEl = document.getElementById("ov-spel-regels");
    const startKnop = document.getElementById("ov-spel-start");
    const terugKnop = document.getElementById("ov-spel-terug");
    const opnieuwKnop = document.getElementById("ov-spel-opnieuw");
    const sluitenKnop = document.getElementById("ov-spel-sluiten");
    const klaarKnop = document.getElementById("ov-spel-klaar");
    const topscoreRegel = document.getElementById("ov-spel-topscore-regel");
    const topscoreEl = document.getElementById("ov-spel-topscore");
    const eindscoreEl = document.getElementById("ov-spel-eindscore");
    const recordEl = document.getElementById("ov-spel-record");
    const eindtopscoreEl = document.getElementById("ov-spel-eindtopscore").querySelector("strong");

    // Iconen in dezelfde stijl als de rest van de app (24x24, alleen lijnen).
    const SKI_PAD =
      '<rect x="4.5" y="2.5" width="4" height="19" rx="2"/><rect x="15.5" y="2.5" width="4" height="19" rx="2"/><path d="M4.5 8h4"/><path d="M15.5 8h4"/><path d="M2 21.5h9"/><path d="M13 21.5h9"/>';
    const WIEL_PAD =
      '<circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/>';
    const HELM_PAD =
      '<path d="M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5"/><path d="M14 6a6 6 0 0 1 6 6v3"/><path d="M4 15v-3a6 6 0 0 1 6-6"/><rect x="2" y="15" width="20" height="4" rx="1"/>';
    const SLEUTEL_PAD =
      '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z"/>';
    const LAMP_PAD = '<circle cx="12" cy="9" r="5"/><path d="M12 14v3"/><path d="M9 20h6"/>';
    const PAD_ALERT =
      '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/>';
    const PAD_CHECK = '<path d="M20 6 9 17l-5-5"/>';
    const MATERIAAL_ICONEN = [SKI_PAD, WIEL_PAD, HELM_PAD];
    const MEMORY_ICONEN = [SKI_PAD, WIEL_PAD, HELM_PAD, SLEUTEL_PAD, LAMP_PAD, PAD_CHECK];

    function svg(paden, maat) {
      return `<svg width="${maat}" height="${maat}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${paden}</svg>`;
    }

    // --- gedeelde topscore-opslag ---
    function haalTopscore(sleutel) {
      try {
        return Number(localStorage.getItem(sleutel)) || 0;
      } catch {
        return 0;
      }
    }
    function zetTopscore(sleutel, waarde) {
      try {
        localStorage.setItem(sleutel, String(waarde));
      } catch {
        // Geen opslag beschikbaar (bv. privénavigatie) — de score onthouden
        // is een leuke bijkomstigheid, geen vereiste.
      }
    }

    // --- Spel 1: Werkplaats Rush ---
    const werkplaatsScoreEl = document.getElementById("ov-spel-score");
    const werkplaatsTijdEl = document.getElementById("ov-spel-tijd");
    const werkplaatsBalkEl = document.getElementById("ov-spel-balk");
    const werkplaatsRooster = document.getElementById("ov-spel-rooster");
    const werkplaatsSlots = Array.from(overlay.querySelectorAll(".ov-slot"));
    let werkplaatsScore = 0;
    let werkplaatsTijdOver = WERKPLAATS_SPEELDUUR;
    let werkplaatsTikId = null;
    let werkplaatsSpawnId = null;
    const werkplaatsLeegTimers = new Map(); // slot-element -> setTimeout-id

    function werkplaatsLeegSlot(slotEl) {
      const id = werkplaatsLeegTimers.get(slotEl);
      if (id) clearTimeout(id);
      werkplaatsLeegTimers.delete(slotEl);
      delete slotEl.dataset.status;
      slotEl.innerHTML = "";
      slotEl.classList.remove("ov-item-actief");
    }

    function werkplaatsPlaatsItem(slotEl) {
      const nodig = Math.random() < 0.78;
      const paden = MATERIAAL_ICONEN[Math.floor(Math.random() * MATERIAAL_ICONEN.length)];
      slotEl.dataset.status = nodig ? "nodig" : "orde";
      slotEl.innerHTML = `
        <span class="ov-item flex h-full w-full items-center justify-center rounded-card ${
          nodig ? "bg-amber-tint text-amber-text" : "bg-green-tint text-green-text"
        }">${svg(paden, 22)}</span>
        <span class="ov-item absolute -right-1 -top-1 flex h-[18px] w-[18px] items-center justify-center rounded-full text-creme ${
          nodig ? "bg-amber-text" : "bg-green-figure"
        }">${svg(nodig ? PAD_ALERT : PAD_CHECK, 11)}</span>
      `;
      slotEl.classList.add("ov-item-actief");
      const levensduur = 950 + Math.random() * 400;
      werkplaatsLeegTimers.set(
        slotEl,
        setTimeout(() => werkplaatsLeegSlot(slotEl), levensduur)
      );
    }

    function werkplaatsPlanSpawn() {
      if (status !== "spel-werkplaatsRush") return;
      const vrij = werkplaatsSlots.filter((el) => !el.dataset.status);
      if (vrij.length > 0) {
        werkplaatsPlaatsItem(vrij[Math.floor(Math.random() * vrij.length)]);
      }
      werkplaatsSpawnId = setTimeout(werkplaatsPlanSpawn, 550 + Math.random() * 350);
    }

    function werkplaatsOpSlotKlik(event) {
      if (status !== "spel-werkplaatsRush") return;
      const slot = event.target.closest(".ov-slot");
      if (!slot || !slot.dataset.status) return;

      const nodig = slot.dataset.status === "nodig";
      werkplaatsScore = Math.max(0, werkplaatsScore + (nodig ? 10 : -5));
      werkplaatsScoreEl.textContent = String(werkplaatsScore);
      slot.classList.add(nodig ? "ov-flits-goed" : "ov-flits-fout");
      setTimeout(() => slot.classList.remove("ov-flits-goed", "ov-flits-fout"), 220);
      werkplaatsLeegSlot(slot);
    }

    function werkplaatsStop() {
      clearInterval(werkplaatsTikId);
      clearTimeout(werkplaatsSpawnId);
      werkplaatsTikId = null;
      werkplaatsSpawnId = null;
      werkplaatsSlots.forEach(werkplaatsLeegSlot);
    }

    function werkplaatsStart() {
      werkplaatsScore = 0;
      werkplaatsTijdOver = WERKPLAATS_SPEELDUUR;
      werkplaatsScoreEl.textContent = "0";
      werkplaatsTijdEl.textContent = String(werkplaatsTijdOver);
      werkplaatsBalkEl.style.width = "100%";
      toonScherm("spel-werkplaatsRush");

      werkplaatsTikId = setInterval(() => {
        werkplaatsTijdOver -= 1;
        werkplaatsTijdEl.textContent = String(Math.max(0, werkplaatsTijdOver));
        werkplaatsBalkEl.style.width = `${Math.max(0, (werkplaatsTijdOver / WERKPLAATS_SPEELDUUR) * 100)}%`;
        if (werkplaatsTijdOver <= 0) {
          werkplaatsStop();
          eindigRonde(werkplaatsScore);
        }
      }, 1000);

      werkplaatsPlanSpawn();
    }

    // --- Spel 2: Onderhoud Memory ---
    const PAAR_PUNTEN = 20;
    const memoryScoreEl = document.getElementById("ov-memory-score");
    const memoryTijdEl = document.getElementById("ov-memory-tijd");
    const memoryBalkEl = document.getElementById("ov-memory-balk");
    const memoryKaarten = Array.from(overlay.querySelectorAll(".ov-kaart"));
    let memoryScore = 0;
    let memoryTijdOver = MEMORY_SPEELDUUR;
    let memoryTikId = null;
    let memoryTerugklapId = null;
    let memoryGevondenParen = 0;
    let memoryGekozen = []; // open, nog niet beoordeelde kaart-elementen
    let memoryVergrendeld = false;

    function memorySchudden() {
      const iconen = MEMORY_ICONEN.slice(0, AANTAL_PAREN).flatMap((pad) => [pad, pad]);
      for (let i = iconen.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [iconen[i], iconen[j]] = [iconen[j], iconen[i]];
      }
      return iconen;
    }

    function memoryZetKaartDicht(kaartEl) {
      kaartEl.classList.remove("ov-kaart-open", "ov-kaart-fout");
      kaartEl.innerHTML = "";
    }

    function memoryOpKaartKlik(event) {
      if (status !== "spel-onderhoudMemory" || memoryVergrendeld) return;
      const kaart = event.target.closest(".ov-kaart");
      if (!kaart || kaart.classList.contains("ov-kaart-open") || kaart.classList.contains("ov-kaart-gevonden"))
        return;

      kaart.classList.add("ov-kaart-open");
      kaart.innerHTML = svg(kaart.dataset.icoon, 22);
      memoryGekozen.push(kaart);
      if (memoryGekozen.length < 2) return;

      memoryVergrendeld = true;
      const [a, b] = memoryGekozen;
      if (a.dataset.icoon === b.dataset.icoon) {
        memoryTerugklapId = setTimeout(() => {
          a.classList.add("ov-kaart-gevonden");
          b.classList.add("ov-kaart-gevonden");
          memoryScore += PAAR_PUNTEN;
          memoryScoreEl.textContent = String(memoryScore);
          memoryGevondenParen += 1;
          memoryGekozen = [];
          memoryVergrendeld = false;
          if (memoryGevondenParen === AANTAL_PAREN) {
            memoryScore += Math.max(0, memoryTijdOver);
            memoryStop();
            eindigRonde(memoryScore);
          }
        }, 260);
      } else {
        a.classList.add("ov-kaart-fout");
        b.classList.add("ov-kaart-fout");
        memoryTerugklapId = setTimeout(() => {
          memoryZetKaartDicht(a);
          memoryZetKaartDicht(b);
          memoryGekozen = [];
          memoryVergrendeld = false;
        }, 700);
      }
    }

    function memoryStop() {
      clearInterval(memoryTikId);
      clearTimeout(memoryTerugklapId);
      memoryTikId = null;
      memoryTerugklapId = null;
      memoryKaarten.forEach(memoryZetKaartDicht);
    }

    function memoryStart() {
      memoryScore = 0;
      memoryTijdOver = MEMORY_SPEELDUUR;
      memoryGevondenParen = 0;
      memoryGekozen = [];
      memoryVergrendeld = false;
      memoryScoreEl.textContent = "0";
      memoryTijdEl.textContent = String(memoryTijdOver);
      memoryBalkEl.style.width = "100%";

      const iconen = memorySchudden();
      memoryKaarten.forEach((kaartEl, i) => {
        kaartEl.dataset.icoon = iconen[i];
        memoryZetKaartDicht(kaartEl);
      });

      toonScherm("spel-onderhoudMemory");

      memoryTikId = setInterval(() => {
        memoryTijdOver -= 1;
        memoryTijdEl.textContent = String(Math.max(0, memoryTijdOver));
        memoryBalkEl.style.width = `${Math.max(0, (memoryTijdOver / MEMORY_SPEELDUUR) * 100)}%`;
        if (memoryTijdOver <= 0) {
          memoryStop();
          eindigRonde(memoryScore);
        }
      }, 1000);
    }

    // --- spelkeuze en gedeelde schermen ---
    const SPELLEN = {
      werkplaatsRush: {
        naam: "Werkplaats Rush",
        opslagsleutel: "ov-werkplaats-rush-topscore",
        uitleg:
          "Er komt materiaal langs uit het rek. Tik weg wat onderhoud nodig heeft, voor de tijd om is. Materiaal dat al in orde is, laat je gewoon staan.",
        regels: [
          { kleur: "bg-amber-text", html: "Onderhoud nodig — tikken: <strong>+10</strong>" },
          { kleur: "bg-green-figure", html: "Al in orde — laat staan, tikken kost <strong>−5</strong>" },
        ],
        start: werkplaatsStart,
      },
      onderhoudMemory: {
        naam: "Onderhoud Memory",
        opslagsleutel: "ov-onderhoud-memory-topscore",
        uitleg:
          "Draai twee kaarten tegelijk om. Zijn het twee dezelfde onderdelen? Dan blijven ze liggen. Ben je klaar voor de tijd om is, dan telt elke seconde die overblijft mee als score.",
        regels: [{ kleur: "bg-accent", html: "Paar gevonden: <strong>+20</strong>" }],
        start: memoryStart,
      },
    };
    let huidigSpelSleutel = null;

    let status = "gesloten"; // gesloten | kiezen | intro | spel-werkplaatsRush | spel-onderhoudMemory | einde

    function toonScherm(naam) {
      status = naam;
      schermen.forEach((el) => {
        el.classList.toggle("hidden", el.dataset.scherm !== naam);
      });
    }

    function kiesSpel(sleutel) {
      huidigSpelSleutel = sleutel;
      const spel = SPELLEN[sleutel];
      titelEl.textContent = spel.naam;
      uitlegEl.textContent = spel.uitleg;
      regelsEl.innerHTML = spel.regels
        .map(
          (r) => `
            <span class="flex items-center gap-2">
              <span class="h-2.5 w-2.5 shrink-0 rounded-full ${r.kleur}"></span>
              ${r.html}
            </span>
          `
        )
        .join("");
      const topscore = haalTopscore(spel.opslagsleutel);
      topscoreRegel.classList.toggle("hidden", topscore <= 0);
      topscoreEl.textContent = String(topscore);
      toonScherm("intro");
      startKnop.focus();
    }

    function eindigRonde(score) {
      const spel = SPELLEN[huidigSpelSleutel];
      const vorigeTopscore = haalTopscore(spel.opslagsleutel);
      const isRecord = score > vorigeTopscore;
      if (isRecord) zetTopscore(spel.opslagsleutel, score);

      eindscoreEl.textContent = String(score);
      recordEl.classList.toggle("hidden", !isRecord);
      eindtopscoreEl.textContent = String(Math.max(score, vorigeTopscore));
      toonScherm("einde");
    }

    function stopAlleTimers() {
      werkplaatsStop();
      memoryStop();
    }

    let laatstFocuste = null;

    function openSpel() {
      laatstFocuste = document.activeElement;
      overlay.classList.remove("hidden");
      overlay.classList.add("flex");
      huidigSpelSleutel = null;
      titelEl.textContent = "Kies een spel";
      toonScherm("kiezen");
    }

    function sluitSpel() {
      overlay.classList.add("hidden");
      overlay.classList.remove("flex");
      stopAlleTimers();
      status = "gesloten";
      if (laatstFocuste instanceof HTMLElement) laatstFocuste.focus();
    }

    // --- dubbelklik op het OV-merkteken, waar het ook staat ---
    document.addEventListener("dblclick", (event) => {
      if (event.target.closest("[data-ov-logo-trigger]")) openSpel();
    });

    overlay.querySelectorAll(".ov-spel-keuze").forEach((knop) => {
      knop.addEventListener("click", () => kiesSpel(knop.dataset.spel));
    });
    terugKnop.addEventListener("click", () => {
      titelEl.textContent = "Kies een spel";
      toonScherm("kiezen");
    });
    werkplaatsRooster.addEventListener("click", werkplaatsOpSlotKlik);
    document.getElementById("ov-memory-rooster").addEventListener("click", memoryOpKaartKlik);
    startKnop.addEventListener("click", () => SPELLEN[huidigSpelSleutel].start());
    opnieuwKnop.addEventListener("click", () => SPELLEN[huidigSpelSleutel].start());
    sluitenKnop.addEventListener("click", sluitSpel);
    klaarKnop.addEventListener("click", sluitSpel);
    overlay.addEventListener("click", (event) => {
      if (event.target === overlay) sluitSpel();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && status !== "gesloten") sluitSpel();
    });
  })();
</script>
