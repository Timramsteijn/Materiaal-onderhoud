---
import { actions } from "astro:actions";
import Basis from "@/layouts/Basis.astro";
import { LoginForm } from "@/components/login-form";
import { Logo } from "@/components/logo";

const resultaat = Astro.getActionResult(actions.inloggen);

// Waar de bezoeker heen wilde voordat de middleware hem hierheen stuurde.
const verder = Astro.url.searchParams.get("verder");
const bestemming = verder?.startsWith("/") && !verder.startsWith("//") ? verder : "/onderdeel";

if (resultaat && !resultaat.error && resultaat.data.ok) {
  return Astro.redirect(bestemming, 303);
}

const mislukt = resultaat?.data && !resultaat.data.ok ? resultaat.data : undefined;
const melding = resultaat?.error
  ? "Er ging iets mis bij het inloggen. Probeer het opnieuw."
  : mislukt?.melding;
// De gebruikersnaam blijft staan na een mislukte poging; het wachtwoord nooit.
const ingevuldeNaam = mislukt?.gebruikersnaam ?? "";

// `verder` blijft in de action-URL staan, zodat het na de POST nog bekend is.
const actieUrl = new URL(Astro.url);
actieUrl.search = actions.inloggen.queryString;
if (verder) actieUrl.searchParams.set("verder", verder);
const actie = `${actieUrl.pathname}${actieUrl.search}`;
---

<Basis titel="Inloggen">
  <div class="flex min-h-full flex-col desktop:flex-row">
    {/* Merkpaneel: volledig scherm op mobiel, 520px kolom op desktop */}
    <div
      class="flex flex-col justify-between bg-navy px-8 py-10 desktop:w-[520px] desktop:shrink-0 desktop:px-12 desktop:py-14"
    >
      <Logo variant="merkteken" size={52} className="text-accent" />
      <div class="mt-10 desktop:mt-0">
        <h1 class="display text-[34px] leading-[1.05] text-creme desktop:text-[44px]">
          Materiaal<br />Onderhoud
        </h1>
        <p class="mt-3 max-w-[38ch] text-[15px] text-text-on-dark">
          Onderhoud aan verhuurmateriaal registreren via de QR-sticker op het materiaal.
        </p>
        <p
          class="mt-6 border-t border-border-dark pt-4 text-[11px] font-bold uppercase tracking-[0.14em] text-text-on-dark"
        >
          Outdoor Valley
        </p>
      </div>
      <div class="desktop:hidden">
        <LoginForm variant="donker" actie={actie} melding={melding} gebruikersnaam={ingevuldeNaam} />
      </div>
    </div>

    {/* Kaart op de zandgrond — alleen desktop; op mobiel staat het formulier hierboven */}
    <div class="hidden flex-1 items-center justify-center bg-zand p-10 desktop:flex">
      <div class="w-full max-w-[420px] rounded-card bg-creme p-8 shadow-[var(--shadow-card)]">
        <h2 class="display text-[26px] text-ink">Inloggen</h2>
        <p class="mb-6 mt-1 text-[13.5px] text-text-muted">
          Met je Outdoor Valley medewerkersaccount.
        </p>
        <LoginForm variant="licht" actie={actie} melding={melding} gebruikersnaam={ingevuldeNaam} />
      </div>
    </div>
  </div>
</Basis>
