---
import Basis from "@/layouts/Basis.astro";
import { Logo } from "@/components/logo";
---

<Basis titel="Niet gevonden">
  <main class="flex min-h-full flex-col items-center justify-center bg-zand px-6 py-16 text-center">
    <Logo variant="merkteken" size={40} className="text-accent" />
    <h1 class="display mt-6 text-[26px] text-ink">Deze pagina bestaat niet</h1>
    <p class="mt-2 max-w-[42ch] text-[13.5px] text-text-muted">
      Controleer de link, of kies hieronder opnieuw een onderdeel.
    </p>
    <a
      href="/onderdeel"
      class="motion lift mt-6 flex min-h-[52px] items-center justify-center rounded-full bg-accent px-6 text-[14px] font-extrabold uppercase tracking-[0.08em] text-accent-on hover:bg-accent-pressed"
    >
      Naar de onderdelen
    </a>
  </main>
</Basis>
