generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  BEHEERDER
  MEDEWERKER
  STAGIAIR
}

enum Status {
  IN_GEBRUIK
  IN_REPARATIE
  BUITEN_GEBRUIK
  TER_GOEDKEURING
}

enum VeldType {
  TEKST
  GETAL
  BEREIK
  DATUM
  KEUZE
}

enum LogSoort {
  REGISTRATIE
  AFKEURING_AANGEVRAAGD
  AFKEURING_GOEDGEKEURD
  AFKEURING_AFGEWEZEN
}

model Medewerker {
  id             String      @id @default(cuid())
  naam           String
  gebruikersnaam String      @unique
  wachtwoordHash String
  rol            Rol         @default(MEDEWERKER)
  /// Vrije tekst, bv. "Beheerder · Ski & Snowboard"
  functie        String      @default("")
  actief         Boolean     @default(true)
  aangemaakt     DateTime    @default(now())
  logregels      LogRegel[]
  beheerlog      BeheerLog[]

  @@map("medewerkers")
}

/// Een bedrijfsonderdeel. Puur configuratie: categorieën bepalen de acties en
/// velden, dus een nieuw onderdeel toevoegen kost geen code.
model Onderdeel {
  id             String      @id @default(cuid())
  naam           String      @unique
  slug           String      @unique
  /// Accentkleur van dit onderdeel; overal via CSS-variabelen doorgevoerd.
  accent         String
  accentPressed  String
  accentTint     String
  /// Sleutel van het icoon (zie components/icons.tsx)
  icoon          String
  uitgelicht     Boolean     @default(false)
  sortering      Int         @default(0)
  /// Alleen voor onderdelen die nog niet zijn ingericht: toont het aantal op
  /// het keuzescherm zolang er nog geen materiaal in de database staat.
  aantalIndicatie Int        @default(0)
  aangemaakt     DateTime    @default(now())
  categorieen    Categorie[]
  materiaal      Materiaal[]

  @@map("onderdelen")
}

model Categorie {
  id          String            @id @default(cuid())
  onderdeelId String
  onderdeel   Onderdeel         @relation(fields: [onderdeelId], references: [id], onDelete: Cascade)
  naam        String
  sortering   Int               @default(0)
  archivedAt  DateTime?
  acties      OnderhoudsActie[]
  velden      VeldDefinitie[]
  materiaal   Materiaal[]

  @@unique([onderdeelId, naam])
  @@index([onderdeelId])
  @@map("categorieen")
}

/// Onderhoudsacties horen bij een categorie, niet bij het onderdeel: Ski en
/// Snowboard zitten in hetzelfde onderdeel en hebben tóch eigen actielijsten.
model OnderhoudsActie {
  id          String    @id @default(cuid())
  categorieId String
  categorie   Categorie @relation(fields: [categorieId], references: [id], onDelete: Cascade)
  naam        String
  /// Markeert de actie die de goedkeuringsflow start.
  isAfkeuren  Boolean   @default(false)
  sortering   Int       @default(0)
  /// Verwijderen = archiveren; bestaande logregels blijven ongemoeid.
  archivedAt  DateTime?

  @@index([categorieId])
  @@map("onderhoudsacties")
}

/// Per categorie eigen materiaalvelden (Ski heeft DIN-bereik, E-MTB een
/// accucapaciteit). De waarden staan als JSON op het materiaal.
model VeldDefinitie {
  id          String    @id @default(cuid())
  categorieId String
  categorie   Categorie @relation(fields: [categorieId], references: [id], onDelete: Cascade)
  naam        String
  type        VeldType  @default(TEKST)
  eenheid     String?
  opties      String[]
  sortering   Int       @default(0)
  archivedAt  DateTime?

  @@index([categorieId])
  @@map("velddefinities")
}

model Materiaal {
  id               String     @id @default(cuid())
  /// Zoals op de QR-sticker; handmatig ingevoerd, nooit gegenereerd.
  materiaalId      String
  onderdeelId      String
  onderdeel        Onderdeel  @relation(fields: [onderdeelId], references: [id])
  categorieId      String
  categorie        Categorie  @relation(fields: [categorieId], references: [id])
  merkModel        String
  locatie          String     @default("")
  status           Status     @default(IN_GEBRUIK)
  /// Status waarnaar teruggedraaid wordt als een afkeuring wordt afgewezen.
  statusVoorKeuring Status?
  inGebruikSinds   DateTime   @default(now())
  laatsteOnderhoud DateTime?
  aantalBeurten    Int        @default(0)
  /// { velddefinitieId: waarde }
  veldwaarden      Json       @default("{}")
  aangemaakt       DateTime   @default(now())
  logregels        LogRegel[]

  @@unique([onderdeelId, materiaalId])
  @@index([categorieId])
  @@map("materiaal")
}

/// Onveranderlijk: een correctie is een nieuwe registratie, geen bewerking.
model LogRegel {
  id             String     @id @default(cuid())
  materiaalDbId  String
  materiaal      Materiaal  @relation(fields: [materiaalDbId], references: [id], onDelete: Cascade)
  /// Tekstkopie, blijft staan als de actie wordt gearchiveerd.
  actieNaam      String
  actieId        String?
  opmerking      String     @default("")
  /// Alleen gevuld als deze registratie de status wijzigde.
  statusNa       Status?
  medewerkerId   String
  medewerker     Medewerker @relation(fields: [medewerkerId], references: [id])
  /// Tekstkopie van de naam op het moment van registreren.
  medewerkerNaam String
  tijdstip       DateTime   @default(now())
  soort          LogSoort   @default(REGISTRATIE)
  /// Idempotentie voor de offline wachtrij.
  clientId       String     @unique

  @@index([materiaalDbId])
  @@index([tijdstip])
  @@map("logregels")
}

/// Auditspoor van beheerwijzigingen: acties, velden, medewerkers, imports.
model BeheerLog {
  id           String     @id @default(cuid())
  medewerkerId String
  medewerker   Medewerker @relation(fields: [medewerkerId], references: [id])
  wat          String
  detail       Json       @default("{}")
  tijdstip     DateTime   @default(now())

  @@index([tijdstip])
  @@map("beheerlog")
}
